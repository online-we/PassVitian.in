# =============================================================================
# PUBLIC (safe in frontend build — Vite only embeds vars prefixed with VITE_)
# =============================================================================
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
# Optional: separate unsigned preset for PDFs (Raw uploads)
# VITE_CLOUDINARY_UPLOAD_PRESET_RAW=your_unsigned_raw_preset

# =============================================================================
# SERVER-ONLY SECRETS (never use VITE_ prefix — never commit real values)
# Set these in Vercel / Netlify dashboard → Environment Variables
# Used only by /api/list-papers and /api/list-bicycles
# =============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =============================================================================
# CLOUDFLARE R2 — new uploads only. Existing papers stay on Cloudinary.
# Server-only. Never use a VITE_ prefix. Set the same names in Vercel.
# =============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_bucket_name
R2_PUBLIC_BASE_URL=https://pub-your-id.r2.dev
